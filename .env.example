# Atlas auth — copy this file to .env and fill in your instance's values.
#
# Client (Vite exposes only VITE_-prefixed vars to the browser).
VITE_ATLAS_PUBLISHABLE_KEY=pk_test_xxx
VITE_ATLAS_FRONTEND_API=https://atlasauth.net

# Server-only JWT verification (read by fetchAtlasAuth() in the server function).
ATLAS_JWKS_URL=https://atlasauth.net/.well-known/jwks.json
ATLAS_ISSUER=https://atlasauth.net
